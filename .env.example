# GitHub Personal Access Token for publishing the generated GitHub Pages site
# Create a fine-grained token at: https://github.com/settings/personal-access-tokens/new
# Scope it to this single repository only, with Repository permissions -> Contents: Read and write.
# Avoid classic tokens (public_repo/repo), which can write to all of your repositories.
GITHUB_TOKEN=your_github_token_here

# Optional: branch used for the latest-only generated site publish
PUBLISH_BRANCH=gh-pages
